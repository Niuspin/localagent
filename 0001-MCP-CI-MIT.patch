+/* 设置 → 扩展：MCP 服务器。界面只有“一行一个服务器 + 展开详情”，所有安全决策在后端（沙箱默认开启，按服务器单独放宽）。 */
+(function () {
+  'use strict';
+  var LA = window.LA = window.LA || {}, el = LA.el, MASK = '••••••';
+  var STATUS = { running: '运行中', idle: '未启动', error: '出错', disabled: '已停用' };
