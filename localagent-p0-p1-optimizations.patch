+def _bad_long(name: str, bad: tuple[str, ...]) -> bool:
+    """名字与危险选项互为前缀（覆盖缩写，如 --outp、--pre-glob）。"""
+    return any(b.startswith(name) or name.startswith(b) for b in bad)
