+"""工具输出落盘：存储、取回工具、精简占位、安全边界（单元测试，不需要假 llama-server）。"""
+from __future__ import annotations
+
+import json
+import sys
+from pathlib import Path
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
