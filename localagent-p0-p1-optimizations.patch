+def _split_flags(args: list[str]) -> tuple[list[str], list[str]]:
+    """把参数拆成 (选项, 位置参数)。“--”之后全部算位置参数。"""
+    flags: list[str] = []
+    pos: list[str] = []
+    rest = False
+    for t in args:
