+def test_env_override_wins(monkeypatch, tmp_path):
+    _freeze(monkeypatch, tmp_path)
+    monkeypatch.setenv("LAGENT_HOME", str(tmp_path / "custom"))
+    assert paths.data_root() == (tmp_path / "custom").resolve()
